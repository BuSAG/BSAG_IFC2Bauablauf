            </xs:restriction>
          </ids:name>
        </ids:entity>
      </ids:applicability>
      <ids:requirements>
        <ids:property cardinality="optional" instructions="Optional; falls vorhanden nur zulaessige Werte: Baustelleneinrichtung, Bauhilfsmassnahme, Drittprojekt. Bei projektspezifischer Erweiterung der Werteliste ist diese Enumeration anzupassen." dataType="IFCLABEL">
          <ids:propertySet>
            <ids:simpleValue>CH_Ing_Uebergeordnet</ids:simpleValue>
          </ids:propertySet>
          <ids:baseName>
            <ids:simpleValue>Status</ids:simpleValue>
          </ids:baseName>
          <ids:value>
            <xs:restriction base="xs:string">
              <xs:enumeration value="Baustelleneinrichtung" />
              <xs:enumeration value="Bauhilfsmassnahme" />
              <xs:enumeration value="Drittprojekt" />
            </xs:restriction>
          </ids:value>
        </ids:property>
